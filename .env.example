# Drizzle
# Replace with your DB credentials!
DATABASE_URL="libsql://db-name-user.turso.io"
# A local DB can also be used in dev as well
# DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

ORIGIN=""

# Auth0 Regular Web Application
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
# Use a long random string for signing the session cookie
AUTH0_SESSION_SECRET=""
# Optional: set this if you request API access tokens
AUTH0_AUDIENCE=""

OPENAI_API_KEY=""
OPENAI_API_MODEL=""
OPENAI_API_REASONING_EFFORT=""
# Optional low-latency settings for Medicine and Calories text capture
OPENAI_API_CAPTURE_MODEL=""
OPENAI_API_CAPTURE_REASONING_EFFORT="low"

# Text capture selects DeepSeek when this key is present.
# Set HEALTH_CAPTURE_PROVIDER to "openai" or "deepseek" when both keys exist.
HEALTH_CAPTURE_PROVIDER=""
DEEPSEEK_API_KEY=""
DEEPSEEK_API_CAPTURE_MODEL="deepseek-v4-flash"
