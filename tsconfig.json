{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		// Every .js under src is compiled from the message catalogs by paraglide on
		// each build. Its Request handling does not typecheck against the Workers
		// global, and the file is regenerated, so the error is not one an edit can
		// clear. Authored code is .ts and .svelte and stays checked.
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler",
		"types": [
			"./src/worker-configuration.d.ts",
			"./worker-configuration.d.ts",
			"node"
		]
	}
}
